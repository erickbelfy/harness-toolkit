# Gastown sandbox environment. Copy to `.env` (same directory) and adjust.
# Loaded automatically by docker compose.

# Git identity used inside the sandbox.
GIT_USER=Your Name
GIT_EMAIL=you@example.com

# Host path mounted at /gt inside the container.
# Default (../..) mounts the project root, since this compose lives in
# .gastown/docker/. Set an absolute path to mount a different folder.
FOLDER=../..

# Host port for the Gastown web dashboard (the container serves it on 8080).
DASHBOARD_PORT=8080

# Gastown version to build into the image. PIN this to a tag from
# https://github.com/steveyegge/gastown/tags for reproducible builds.
GASTOWN_REF=main
